# ========================
# DATABASE CONFIGURATION
# ========================
DB_HOST=localhost
DB_USER=sa
DB_PASSWORD=Admin123
DB_NAME=pos_backend
DB_PORT=3306

# ========================
# JWT & SECURITY
# ========================
JWT_SECRET=se58fht0ken
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5000
MAX_REQUEST_SIZE=10mb

# ========================
# APPLICATION SETTINGS
# ========================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ========================
# ZRA CONFIGURATION (CORE)
# ========================
ZRA_ENABLED=true
ZRA_REQUIRED=false
ZRA_ENVIRONMENT=development   # change to "production" when going live

# ZRA identifiers
ZRA_TPIN=1002010901
ZRA_BHF_ID=000
ZRA_SDC_ID=SDC001

# ========================
# ZRA API ENDPOINTS
# ========================

# Sandbox base (local simulator)
ZRA_BASE_URL=http://localhost:2525
ZRA_SALES_ENDPOINT=/sandboxvsdc/trnsSales/saveSales
ZRA_STOCK_ITEMS_ENDPOINT=/sandboxvsdc/stock/saveStockItems
ZRA_STOCK_MASTER_ENDPOINT=/sandboxvsdc/stockMaster/saveStockMaster
ZRA_AUTH_ENDPOINT=/sandboxvsdc/authenticate

# Production base (real ZRA API)
#ZRA_PRODUCTION_BASE_URL=https://openapi.zra.org.zm
# Production endpoints already start with /api/v1
# Example: /api/v1/sales, /api/v1/stock-items, /api/v1/stock-master, /api/v1/authenticate

# ========================
# ZRA ADVANCED SETTINGS
# ========================
ZRA_TIMEOUT=30000
ZRA_RETRY_ATTEMPTS=3
ZRA_RETRY_DELAY=2000
ZRA_VAT_RATE=16.00
ZRA_DEFAULT_PRODUCT_CLASS=50102518
ZRA_DEFAULT_PACKAGE_UNIT=BA
ZRA_DEFAULT_QUANTITY_UNIT=BE
ZRA_DEFAULT_CURRENCY=ZMW

# ========================
# RECEIPT CONFIGURATION
# ========================
RECEIPT_HEADER=Wisdom Stores
RECEIPT_FOOTER=Thank you for your purchase! VAT Inclusive
RECEIPT_TAX_ID=TPIN: 1002010901
RECEIPT_SHOW_TAX_BREAKDOWN=true
RECEIPT_SHOW_QR_CODE=true
RECEIPT_SHOW_ZRA_COMPLIANCE=true

# ========================
# INVOICE NUMBERING
# ========================
INVOICE_PREFIX=INV
INVOICE_START_NUMBER=1001
INVOICE_SEPARATOR=/
INVOICE_STORE_CODE=WIS1001S

# ========================
# STORE CONFIGURATION
# ========================
DEFAULT_STORE_ID=1
STORE_SDC_ID=SDC1001
STORE_MERCHANT_ID=WIS1001S001
STORE_LOCATION=Ndola, Zambia
STORE_CONTACT=0999999999

# ========================
# LOGGING & DEBUGGING
# ========================
LOG_LEVEL=debug
LOG_ZRA_REQUESTS=true
LOG_ZRA_RESPONSES=true
LOG_DB_QUERIES=false
LOG_TAX_CALCULATIONS=true
LOG_SALES_PROCESSING=true

# ========================
# FILE PATHS
# ========================
QR_CODE_SAVE_PATH=./public/qrcodes
RECEIPT_TEMPLATE_PATH=./templates/receipts
LOG_FILE_PATH=./logs
TEMP_FILE_PATH=./temp

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_ZRA=10
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUESTS_PER_MINUTE=100
