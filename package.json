{
  "name": "pos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "POS backend server",
  "author": "",
  "license": "ISC",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "stress:seed": "node scripts/stressSeed.js",
    "stress:load": "node scripts/stressLoad.js",
    "build:exe": "pkg . --targets node22-win-x64  --output dist/pos-backend.exe"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@yao-pkg/pkg": "^6.10.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.1",
    "nexe-natives": "^1.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pug": "3.0.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "tedious": "^18.6.1",
    "validator": "^13.15.23",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "compression": "Brotli",
    "scripts": [
      "server.js",
      "models/**/*.js"
    ],
    "assets": [
      "migrations/**/*",
      "config/**/*",
      "views/**/*",
      "public/**/*",
      "node_modules/mysql2/build/Release/*.node",
      "node_modules/tedious/build/Release/*.node",
      "!node_modules/open/xdg-open",
      "!node_modules/@azure/identity/node_modules/open/xdg-open"
    ]
  }
}
